# Copy to .env and fill in. .env is git-ignored - never commit real values.

# From @BotFather.
BOT_TOKEN=123456:replace-me

# Telegram user IDs allowed into the admin panel, comma separated.
# Ask @userinfobot for yours. Leave empty to disable the panel entirely.
ADMIN_IDS=

# Where the SQLite file lives.
DATABASE_PATH=data/tzbot.sqlite3

# How often to poll the tracker, in seconds. The upstream caches for 60s,
# so anything below that only burns your own bandwidth.
POLL_INTERVAL=60

# Minute of the hour for the "15 minutes left" heads-up (UTC).
PREALERT_MINUTE=45

# Messages per second during a broadcast. Telegram starts throttling near 30.
BROADCAST_RATE=25

# D2Runewizard asks integrations to identify themselves. The endpoint works
# without a token; a token only unlocks the richer payload (report counts and
# confidence). Request one at https://d2runewizard.com/integration
D2RW_CONTACT=you@example.com
D2RW_PLATFORM=Telegram
D2RW_REPO=https://github.com/cprite/terror-zone-telebot
D2RW_TOKEN=
